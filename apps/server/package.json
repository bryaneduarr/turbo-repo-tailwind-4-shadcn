{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf ./dist ./node_modules/ ./.turbo/",
    "dev": "tsx --watch 'src/index.ts'",
    "drizzle:generate": "bunx drizzle-kit generate --config ./drizzle.config.ts",
    "drizzle:migrate": "bunx drizzle-kit migrate --config ./drizzle.config.ts",
    "drizzle:push": "bunx drizzle-kit push --config ./drizzle.config.ts",
    "drizzle:studio": "bunx drizzle-kit studio --config ./drizzle.config.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "node ./dist/src/index.js",
    "update": "bun update --latest"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@hono/zod-openapi": "^1.2.4",
    "@scalar/hono-api-reference": "^0.10.6",
    "dotenv": "^17.4.0",
    "hono": "^4.12.10",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0"
  }
}
