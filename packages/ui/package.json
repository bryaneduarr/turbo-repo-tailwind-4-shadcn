{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf node_modules/ .turbo/",
    "check-types": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "update": "bun update --latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@workspace/tailwind": "workspace:*",
    "tsx": "^4.21.0"
  },
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./ui/*": "./src/components/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./utils/*": "./src/lib/utils/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
